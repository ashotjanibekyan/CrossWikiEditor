<Application
    x:Class="CrossWikiEditor.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <!--  Wikimedia "progressive" blue as the accent colour  -->
                <ColorPaletteResources x:Key="Light" Accent="#3366CC" />
                <ColorPaletteResources x:Key="Dark" Accent="#6D8FE0" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="/Styles/AppStyles.axaml" />
        <StyleInclude Source="/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="/Styles/DialogStyles.axaml" />
    </Application.Styles>
</Application>
