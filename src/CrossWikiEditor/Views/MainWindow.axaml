<Window
    x:Class="CrossWikiEditor.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
    xmlns:controlViews="clr-namespace:CrossWikiEditor.Views.ControlViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reportViews="clr-namespace:CrossWikiEditor.Views.ReportViews"
    xmlns:viewModels="clr-namespace:CrossWikiEditor.Core.ViewModels;assembly=CrossWikiEditor.Core"
    xmlns:views="clr-namespace:CrossWikiEditor.Views"
    Title="CrossWikiEditor"
    MinWidth="1000"
    MinHeight="640"
    d:DesignHeight="800"
    d:DesignWidth="1400"
    x:DataType="viewModels:MainWindowViewModel"
    Background="{DynamicResource AppBackgroundBrush}"
    Icon="/Assets/avalonia-logo.ico"
    WindowState="Maximized"
    mc:Ignorable="d">

    <DockPanel>
        <Border
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <views:MenuView DataContext="{Binding MenuViewModel}" />
        </Border>

        <views:StatusBarView DataContext="{Binding StatusBarViewModel}" DockPanel.Dock="Bottom" />

        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" MinHeight="420" />
            </Grid.RowDefinitions>

            <!--  Preview / diff  -->
            <Border Grid.Row="0" Classes="Card">
                <av:HtmlPanel x:Name="HtmlPanel" Margin="6" />
            </Border>

            <GridSplitter
                Grid.Row="1"
                Classes="Gap"
                ResizeDirection="Rows" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="240" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="480" MinWidth="440" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                </Grid.ColumnDefinitions>

                <!--  Page list  -->
                <Border Grid.Column="0" Classes="Card">
                    <views:MakeListView DataContext="{Binding MakeListViewModel}" />
                </Border>

                <GridSplitter
                    Grid.Column="1"
                    Classes="Gap"
                    ResizeDirection="Columns" />

                <!--  Processing options  -->
                <Border Grid.Column="2" Classes="Card">
                    <TabControl Padding="0">
                        <TabItem Header="Options">
                            <ScrollViewer>
                                <controlViews:OptionsView DataContext="{Binding OptionsViewModel}" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="More">
                            <ScrollViewer>
                                <controlViews:MoreView DataContext="{Binding MoreViewModel}" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Disambig">
                            <controlViews:DisambigView DataContext="{Binding DisambigViewModel}" />
                        </TabItem>
                        <TabItem Header="Skip">
                            <ScrollViewer>
                                <controlViews:SkipView DataContext="{Binding SkipViewModel}" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Start">
                            <controlViews:StartView DataContext="{Binding StartViewModel}" />
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter
                    Grid.Column="3"
                    Classes="Gap"
                    ResizeDirection="Columns" />

                <!--  Page content and reports  -->
                <Border Grid.Column="4" Classes="Card">
                    <TabControl Padding="0">
                        <TabItem Header="Edit box">
                            <reportViews:EditBoxView DataContext="{Binding EditBoxViewModel}" />
                        </TabItem>
                        <TabItem Header="History">
                            <reportViews:HistoryView DataContext="{Binding HistoryViewModel}" />
                        </TabItem>
                        <TabItem Header="What links here">
                            <reportViews:WhatLinksHereView DataContext="{Binding WhatLinksHereViewModel}" />
                        </TabItem>
                        <TabItem Header="Logs">
                            <reportViews:LogsView DataContext="{Binding LogsViewModel}" />
                        </TabItem>
                        <TabItem Header="Page logs">
                            <reportViews:PageLogsView DataContext="{Binding PageLogsViewModel}" />
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
