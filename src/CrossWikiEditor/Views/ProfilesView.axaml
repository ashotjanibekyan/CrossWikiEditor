<Window
    x:Class="CrossWikiEditor.Views.ProfilesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:CrossWikiEditor.Core.ViewModels;assembly=CrossWikiEditor.Core"
    x:Name="This"
    Title="Profiles"
    Width="640"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="viewModels:ProfilesViewModel"
    Classes="DialogWindow"
    SizeToContent="Height"
    mc:Ignorable="d">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto">
        <DataGrid
            Grid.Row="0"
            Height="280"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            GridLinesVisibility="Horizontal"
            IsReadOnly="True"
            ItemsSource="{Binding Profiles}"
            SelectedItem="{Binding SelectedProfile}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="Id" />
                <DataGridTextColumn Binding="{Binding Username}" Header="Username" />
                <DataGridCheckBoxColumn Binding="{Binding IsPasswordSaved}" Header="Password saved?" />
                <DataGridTextColumn Binding="{Binding DefaultSettingsPath}" Header="Default settings" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Notes}"
                    Header="Notes" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid
            Grid.Row="1"
            Margin="0,8,0,0"
            ColumnDefinitions="Auto,*,Auto">
            <Button
                Grid.Column="0"
                MinWidth="88"
                Classes="accent"
                Command="{Binding LoginCommand}"
                CommandParameter="{Binding #This}"
                Content="Log in"
                IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Grid.Column="2" Classes="DialogButtons">
                <Button Command="{Binding AddCommand}" Content="Add…" />
                <Button
                    Command="{Binding EditCommand}"
                    Content="Edit…"
                    IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button
                    Classes="danger"
                    Command="{Binding DeleteCommand}"
                    Content="Delete"
                    IsEnabled="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Grid>
        <HeaderedContentControl
            Grid.Row="2"
            Margin="0,16,0,0"
            Header="Quick login">
            <Grid
                Classes="Form"
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Password" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Username}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    PasswordChar="•"
                    RevealPassword="False"
                    Text="{Binding Password}" />
                <Button
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    MinWidth="88"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding QuickLoginCommand}"
                    CommandParameter="{Binding #This}"
                    Content="Log in" />
            </Grid>
        </HeaderedContentControl>
    </Grid>
</Window>
