<UserControl
    x:Class="CrossWikiEditor.Views.ControlViews.StartView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:CrossWikiEditor.Core.ViewModels.ControlViewModels;assembly=CrossWikiEditor.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="480"
    x:DataType="controlViewModels:StartViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Grid.Actions Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Grid.Stats TextBlock">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style Selector="Grid.Stats TextBlock:nth-child(odd)">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,2,12,2" />
        </Style>
        <Style Selector="Grid.Stats TextBlock:nth-child(even)">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*">
        <!--  Edit summary  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,4"
            Classes="Muted"
            Text="Default summary" />
        <Grid
            Grid.Row="1"
            Margin="0,0,0,10"
            ColumnDefinitions="*,Auto,Auto">
            <TextBox
                Grid.Column="0"
                Margin="0,0,12,0"
                Watermark="Edit summary" />
            <CheckBox Grid.Column="1" Margin="0,0,12,0">Lock</CheckBox>
            <CheckBox Grid.Column="2">Minor edit</CheckBox>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
            <!--  Left column  -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <HeaderedContentControl
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Header="Page statistics">
                    <Grid
                        Classes="Stats"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Words" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WordsStats}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Links" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LinksStats}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Images" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImagesStats}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Categories" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CategoriesStats}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Interwiki links" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InterwikiLinksStats}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Dates O/I/A" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DatesStats}" />
                    </Grid>
                </HeaderedContentControl>
                <HeaderedContentControl Grid.Row="1" Header="Alerts">
                    <TextBox
                        MinHeight="60"
                        IsReadOnly="True"
                        TextWrapping="Wrap" />
                </HeaderedContentControl>
            </Grid>

            <!--  Right column  -->
            <StackPanel Grid.Column="2">
                <Grid Classes="Actions" ColumnDefinitions="*,6,*">
                    <Button
                        Grid.Column="0"
                        Classes="accent"
                        Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlay}" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding StopCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconStop}" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid
                    Classes="Actions"
                    ColumnDefinitions="*,6,*"
                    RowDefinitions="Auto,Auto,Auto">
                    <Button Grid.Row="0" Grid.Column="0">Preview</Button>
                    <Button Grid.Row="0" Grid.Column="2">Diff</Button>
                    <Button Grid.Row="1" Grid.Column="0">Watch</Button>
                    <Button Grid.Row="1" Grid.Column="2">Move</Button>
                    <Button Grid.Row="2" Grid.Column="0">Protect</Button>
                    <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Classes="danger">
                        Delete
                    </Button>
                </Grid>

                <Grid Classes="Actions" ColumnDefinitions="*,6,*">
                    <Button
                        Grid.Column="0"
                        MinHeight="40"
                        Command="{Binding SkipCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconSkip}" />
                            <TextBlock Text="Skip" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        MinHeight="40"
                        Classes="success"
                        Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconCheck}" />
                            <TextBlock FontWeight="SemiBold" Text="Save" />
                        </StackPanel>
                    </Button>
                </Grid>

                <HeaderedContentControl Margin="0,4,0,0" Header="Find">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Margin="0,0,6,0" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Find"
                                ToolTip.Tip="Find">
                                <PathIcon Data="{StaticResource IconSearch}" />
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <CheckBox>Regex</CheckBox>
                            <CheckBox>Case sensitive</CheckBox>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
