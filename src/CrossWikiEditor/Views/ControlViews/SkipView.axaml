<UserControl
    x:Class="CrossWikiEditor.Views.ControlViews.SkipView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="480"
    mc:Ignorable="d">
    <StackPanel Margin="12" Spacing="10">
        <HeaderedContentControl Header="Text">
            <StackPanel Spacing="2">
                <Grid ColumnDefinitions="140,*">
                    <CheckBox Grid.Column="0" IsChecked="True">
                        Contains
                    </CheckBox>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <StackPanel
                    Margin="28,0,0,6"
                    Orientation="Horizontal"
                    Spacing="16">
                    <CheckBox>Regex</CheckBox>
                    <CheckBox>Case sensitive</CheckBox>
                    <CheckBox>Check after</CheckBox>
                </StackPanel>
                <Grid ColumnDefinitions="140,*">
                    <CheckBox Grid.Column="0" IsChecked="True">
                        Doesn't contain
                    </CheckBox>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <StackPanel
                    Margin="28,0,0,0"
                    Orientation="Horizontal"
                    Spacing="16">
                    <CheckBox>Regex</CheckBox>
                    <CheckBox>Case sensitive</CheckBox>
                    <CheckBox>Check after</CheckBox>
                </StackPanel>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Header="General skip options">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <CheckBox Grid.Row="0" Grid.Column="0">
                    Page is in use
                </CheckBox>
                <CheckBox Grid.Row="0" Grid.Column="1">
                    Edit blocked by spam filter
                </CheckBox>
                <CheckBox Grid.Row="1" Grid.Column="0">
                    Page contains no links
                </CheckBox>
                <CheckBox Grid.Row="1" Grid.Column="1">
                    Page is redirect
                </CheckBox>
                <CheckBox Grid.Row="2" Grid.Column="0">
                    No changes are made
                </CheckBox>
                <CheckBox Grid.Row="2" Grid.Column="1">
                    No alert
                </CheckBox>
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="24,0,0,0">
                    Only whitespace
                </CheckBox>
                <CheckBox Grid.Row="3" Grid.Column="1">
                    Only casing
                </CheckBox>
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="24,0,0,0">
                    Only genfixes
                </CheckBox>
                <CheckBox Grid.Row="4" Grid.Column="1">
                    Only minor genfixes
                </CheckBox>
                <CheckBox
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="24,0,0,0">
                    Only cosmetic changes
                </CheckBox>
            </Grid>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Page">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <RadioButton Content="Exists" GroupName="PageExistence" />
                <RadioButton Content="Doesn't exist" GroupName="PageExistence" />
                <RadioButton
                    Content="Don't care"
                    GroupName="PageExistence"
                    IsChecked="True" />
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
