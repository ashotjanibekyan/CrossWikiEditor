<UserControl
    x:Class="CrossWikiEditor.Views.ControlViews.MoreView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlVm="using:CrossWikiEditor.Core.ViewModels.ControlViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:CrossWikiEditor.Core.Settings"
    xmlns:utils="using:CrossWikiEditor.Converters"
    d:DesignHeight="450"
    d:DesignWidth="480"
    x:DataType="controlVm:MoreViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Grid.Form > :is(Control)">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style Selector="Grid.Form > :is(Control)[(Grid.Column)=0]">
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style Selector="Grid.Form > ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <StackPanel Margin="12" Spacing="10">
        <HeaderedContentControl
            Header="Append / prepend text">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsAppendOrPrependEnabled}">
                        Enabled
                    </CheckBox>
                    <RadioButton
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        Content="Append"
                        GroupName="Mode"
                        IsChecked="{Binding IsAppend}" />
                    <RadioButton
                        Grid.Column="2"
                        Content="Prepend"
                        GroupName="Mode"
                        IsChecked="{Binding !IsAppend}" />
                </Grid>
                <TextBox
                    Height="80"
                    AcceptsReturn="True"
                    FontFamily="{StaticResource AppMonospaceFont}"
                    Text="{Binding AppendOrPrependContent}"
                    TextWrapping="Wrap"
                    Watermark="Text to append or prepend" />
                <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                    <TextBlock Grid.Column="0" Classes="FieldLabel">Use</TextBlock>
                    <NumericUpDown
                        Grid.Column="1"
                        Width="60"
                        IsEnabled="{Binding IsAppendOrPrependEnabled}"
                        ShowButtonSpinner="False"
                        Value="{Binding AppendOrPrependNewLines}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Classes="FieldLabel">
                        newlines
                    </TextBlock>
                    <CheckBox
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding ShouldSortMetadataAfterAppendOrPrepend}"
                        IsEnabled="{Binding IsAppendOrPrependEnabled}">
                        Sort metadata after
                    </CheckBox>
                </Grid>
            </StackPanel>
        </HeaderedContentControl>
        <HeaderedContentControl
            Header="Files">
            <Grid
                Classes="Form"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto">
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="0"
                    SelectedIndex="{Binding FileType}">
                    <ComboBoxItem>Choose a task...</ComboBoxItem>
                    <ComboBoxItem>Replace file:</ComboBoxItem>
                    <ComboBoxItem>Remove file:</ComboBoxItem>
                    <ComboBoxItem>Comment out file:</ComboBoxItem>
                </ComboBox>
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Text="{Binding SourceFile}">
                    <TextBox.IsEnabled>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="FileType" />
                            <Binding Source="{x:Static settings:FileTaskType.Replace}" />
                            <Binding Source="{x:Static settings:FileTaskType.Remove}" />
                            <Binding Source="{x:Static settings:FileTaskType.CommentOut}" />
                        </MultiBinding>
                    </TextBox.IsEnabled>
                </TextBox>
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Label.IsVisible>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="FileType" />
                            <Binding Source="{x:Static settings:FileTaskType.Replace}" />
                        </MultiBinding>
                    </Label.IsVisible>
                    With:
                </Label>
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Label.IsVisible>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="FileType" />
                            <Binding Source="{x:Static settings:FileTaskType.CommentOut}" />
                        </MultiBinding>
                    </Label.IsVisible>
                    Comment:
                </Label>
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Text="{Binding ReplaceFileOrComment}">
                    <TextBox.IsEnabled>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="FileType" />
                            <Binding Source="{x:Static settings:FileTaskType.Replace}" />
                            <Binding Source="{x:Static settings:FileTaskType.CommentOut}" />
                        </MultiBinding>
                    </TextBox.IsEnabled>
                </TextBox>
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="0"
                    IsChecked="{Binding SkipIfNoFileChanged}">
                    <CheckBox.IsEnabled>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="FileType" />
                            <Binding Source="{x:Static settings:FileTaskType.Replace}" />
                            <Binding Source="{x:Static settings:FileTaskType.Remove}" />
                            <Binding Source="{x:Static settings:FileTaskType.CommentOut}" />
                        </MultiBinding>
                    </CheckBox.IsEnabled>
                    Skip if no file changed
                </CheckBox>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl
            Header="Categories">
            <Grid
                Classes="Form"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto">
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="0"
                    SelectedIndex="{Binding CategoryType}">
                    <ComboBoxItem>Choose a task...</ComboBoxItem>
                    <ComboBoxItem>Replace category:</ComboBoxItem>
                    <ComboBoxItem>Add category:</ComboBoxItem>
                    <ComboBoxItem>Remove category:</ComboBoxItem>
                </ComboBox>
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Text="{Binding SourceCategory}">
                    <TextBox.IsEnabled>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="CategoryType" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Replace}" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Add}" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Remove}" />
                        </MultiBinding>
                    </TextBox.IsEnabled>
                </TextBox>
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Label.IsVisible>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="CategoryType" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Replace}" />
                        </MultiBinding>
                    </Label.IsVisible>
                    With:
                </Label>
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Text="{Binding ReplaceCategory}">
                    <TextBox.IsEnabled>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="CategoryType" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Replace}" />
                        </MultiBinding>
                    </TextBox.IsEnabled>
                </TextBox>
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="0"
                    IsChecked="{Binding SkipIfNoCategoryChanged}">
                    <CheckBox.IsEnabled>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="CategoryType" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Replace}" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Add}" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Remove}" />
                        </MultiBinding>
                    </CheckBox.IsEnabled>
                    Skip if no category changed
                </CheckBox>
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    IsChecked="{Binding RemoveSortkey}">
                    <CheckBox.IsEnabled>
                        <MultiBinding Converter="{x:Static utils:Converters.FirstEqualsToAnyConverter}">
                            <Binding Path="CategoryType" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Replace}" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Add}" />
                            <Binding Source="{x:Static settings:CategoryTaskType.Remove}" />
                        </MultiBinding>
                    </CheckBox.IsEnabled>
                    Remove sortkey
                </CheckBox>
            </Grid>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>