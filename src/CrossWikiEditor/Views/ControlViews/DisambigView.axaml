<UserControl
    x:Class="CrossWikiEditor.Views.ControlViews.DisambigView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:CrossWikiEditor.Core.ViewModels.ControlViewModels;assembly=CrossWikiEditor.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="480"
    x:DataType="controlViewModels:DisambigViewModel"
    mc:Ignorable="d">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*">
        <CheckBox
            Grid.Row="0"
            Margin="0,0,0,6"
            IsChecked="{Binding EnableDisambiguation}">
            Enable disambiguation
        </CheckBox>
        <HeaderedContentControl
            Grid.Row="1"
            Margin="0,0,0,10"
            Header="Link to disambiguate">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Text="{Binding LinkToDisambiguate}"
                    Watermark="Page title" />
                <Button Grid.Column="1" Command="{Binding LoadCommand}">
                    Load links
                </Button>
            </Grid>
        </HeaderedContentControl>
        <HeaderedContentControl Grid.Row="2" Header="Variants">
            <DockPanel>
                <Grid
                    Margin="0,8,0,0"
                    ColumnDefinitions="Auto,Auto,Auto"
                    DockPanel.Dock="Bottom">
                    <TextBlock Grid.Column="0" Classes="FieldLabel">Use</TextBlock>
                    <NumericUpDown
                        Grid.Column="1"
                        Width="60"
                        ShowButtonSpinner="False"
                        Value="{Binding ContextCharacterCount}" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Classes="FieldLabel">
                        characters for context
                    </TextBlock>
                </Grid>
                <CheckBox
                    Margin="0,6,0,0"
                    DockPanel.Dock="Bottom"
                    IsChecked="{Binding SkipPageNoDisambiguationsMade}">
                    Skip page when no disambiguations made
                </CheckBox>
                <TextBox
                    AcceptsReturn="True"
                    FontFamily="{StaticResource AppMonospaceFont}"
                    TextWrapping="Wrap"
                    Watermark="One variant per line" />
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</UserControl>
