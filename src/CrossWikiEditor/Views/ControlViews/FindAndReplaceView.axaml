<Window
    x:Class="CrossWikiEditor.Views.ControlViews.FindAndReplaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:CrossWikiEditor.Core.ViewModels.ControlViewModels;assembly=CrossWikiEditor.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="This"
    Title="Find and Replace"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="controlViewModels:FindAndReplaceViewModel"
    Classes="DialogWindow"
    Height="560"
    MinHeight="360"
    SizeToContent="Width"
    mc:Ignorable="d">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <Grid
            Grid.Row="0"
            Margin="0,0,0,12"
            ColumnDefinitions="*,24,Auto">
            <StackPanel Grid.Column="0">
                <CheckBox Content="Ignore external/interwiki links, images, nowiki, math and &lt;!-- --&gt;" IsChecked="{Binding IgnoreLinks}" />
                <CheckBox Content="Ignore templates, refs, link targets, and headings" IsChecked="{Binding IgnoreMore}" />
                <CheckBox Content="Add replacements to edit summary" IsChecked="{Binding AddToSummary}" />
                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        Text="Regex help:" />
                    <HyperlinkButton
                        Padding="2,0"
                        Content="Regular expressions on Wikipedia"
                        NavigateUri="https://en.wikipedia.org/wiki/Regular_expression" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Muted"
                        Text="·" />
                    <HyperlinkButton
                        Padding="2,0"
                        Content=".NET regex docs"
                        NavigateUri="https://learn.microsoft.com/en-us/dotnet/standard/base-types/regular-expressions" />
                </StackPanel>
            </StackPanel>
            <Grid
                Grid.Column="2"
                VerticalAlignment="Bottom"
                ColumnDefinitions="*,Auto">
                <TextBox
                    Grid.Column="0"
                    Width="220"
                    Margin="0,0,6,0"
                    Watermark="Search rules" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Search rules"
                    ToolTip.Tip="Search rules">
                    <PathIcon Data="{StaticResource IconSearch}" />
                </Button>
            </Grid>
        </Grid>
        <DataGrid
            Grid.Row="1"
            MinHeight="200"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            GridLinesVisibility="All"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            ItemsSource="{Binding NormalFindAndReplaceRules}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Find}"
                    Header="Find"
                    IsReadOnly="False" />
                <DataGridTextColumn
                    Binding="{Binding ReplaceWith}"
                    Header="Replace with"
                    IsReadOnly="False" />
                <DataGridCheckBoxColumn
                    Binding="{Binding CaseSensitive}"
                    Header="Case sensitive"
                    IsReadOnly="False" />
                <DataGridCheckBoxColumn
                    Binding="{Binding Regex}"
                    Header="Regex"
                    IsReadOnly="False" />
                <DataGridCheckBoxColumn
                    Binding="{Binding MultiLine}"
                    Header="MultiLine"
                    IsReadOnly="False" />
                <DataGridCheckBoxColumn
                    Binding="{Binding SingleLine}"
                    Header="SingleLine"
                    IsReadOnly="False" />
                <DataGridCheckBoxColumn
                    Binding="{Binding Minor}"
                    Header="Minor"
                    IsReadOnly="False" />
                <DataGridCheckBoxColumn
                    Binding="{Binding AfterFixes}"
                    Header="After fixes"
                    IsReadOnly="False" />
                <DataGridCheckBoxColumn
                    Binding="{Binding Enabled}"
                    Header="Enabled"
                    IsReadOnly="False" />
                <DataGridTextColumn
                    Binding="{Binding Comment}"
                    Header="Comment"
                    IsReadOnly="False" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid
            Grid.Row="2"
            Margin="0,12,0,0"
            ColumnDefinitions="Auto,*,Auto">
            <Button
                Grid.Column="0"
                MinWidth="88"
                Command="{Binding CleanCommand}"
                Content="Clear" />
            <StackPanel Grid.Column="2" Classes="DialogButtons">
                <Button
                    Classes="accent"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding #This}"
                    Content="OK" />
                <Button Content="Cancel" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>