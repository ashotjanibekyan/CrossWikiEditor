<UserControl
    x:Class="CrossWikiEditor.Views.ControlViews.OptionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controlViewModels="clr-namespace:CrossWikiEditor.Core.ViewModels.ControlViewModels;assembly=CrossWikiEditor.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="480"
    x:DataType="controlViewModels:OptionsViewModel"
    mc:Ignorable="d">
    <StackPanel Margin="12" Spacing="10">
        <HeaderedContentControl Header="Automatic changes">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <CheckBox IsChecked="{Binding AutoTag}">Auto tag</CheckBox>
                    <CheckBox IsChecked="{Binding ApplyGeneralFixes}">Apply general fixes</CheckBox>
                    <CheckBox IsChecked="{Binding UnicodifyWholePage}">Unicodify whole page</CheckBox>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="150"
                    VerticalAlignment="Center">
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap">Auto changes skip options</TextBlock>
                </Button>
            </Grid>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Find and replace">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <CheckBox IsChecked="{Binding FindAndReplace}">Enable find and replace</CheckBox>
                    <TextBlock
                        Margin="0,8,0,2"
                        Classes="Muted"
                        Text="Skip page if" />
                    <CheckBox Margin="12,0,0,0" IsChecked="{Binding SkipIfNoReplacement}">no replacement</CheckBox>
                    <CheckBox Margin="12,0,0,0" IsChecked="{Binding SkipIfOnlyMinorReplacementMade}">only minor replacement made</CheckBox>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Width="150"
                    Spacing="6">
                    <Button HorizontalAlignment="Stretch" Command="{Binding OpenNormalFindAndReplaceDialogCommand}">Normal settings</Button>
                    <Button HorizontalAlignment="Stretch">Advanced settings</Button>
                    <Button HorizontalAlignment="Stretch">Template substitution</Button>
                </StackPanel>
            </Grid>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Typo fixing">
            <StackPanel>
                <CheckBox IsChecked="{Binding RegexTypoFixing}">Regex typo fixing</CheckBox>
                <CheckBox IsChecked="{Binding SkipIfNoTypoFixed}">Skip if no typo fixed</CheckBox>
            </StackPanel>
        </HeaderedContentControl>
    </StackPanel>
</UserControl>
