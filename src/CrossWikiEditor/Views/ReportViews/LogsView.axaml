<UserControl
    x:Class="CrossWikiEditor.Views.ReportViews.LogsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <TextBlock Margin="24" Classes="EmptyState" Text="Saved and skipped pages will be logged here." />
</UserControl>