<UserControl
    x:Class="CrossWikiEditor.Views.ReportViews.EditBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reportViewModels="clr-namespace:CrossWikiEditor.Core.ViewModels.ReportViewModels;assembly=CrossWikiEditor.Core"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="reportViewModels:EditBoxViewModel"
    mc:Ignorable="d">
    <TextBox
        Padding="10,8"
        AcceptsReturn="True"
        AcceptsTab="True"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="0"
        FontFamily="{StaticResource AppMonospaceFont}"
        FontSize="13"
        Text="{Binding Content}"
        TextWrapping="Wrap" />
</UserControl>